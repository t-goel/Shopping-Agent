{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shopping-agent/ingest-v1",
  "title": "Shopping-Agent ingest-v1",
  "description": "Sidecar that projects into catalog-v2 Product rows and multi-store assortment listings. Ground-truth attributes live on products; price/stock/sponsored are per-store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ingest_version", "stores", "products", "assortment"],
  "properties": {
    "ingest_version": {
      "const": "ingest-v1"
    },
    "notes": {
      "type": "string",
      "description": "Human-facing alignment notes; ignored by projectors."
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["store_id", "name", "brand_seller"],
        "properties": {
          "store_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "brand_seller": {
            "type": "string",
            "minLength": 1,
            "description": "Storefront chrome / branding only. Do NOT project onto Product.seller — a shared product_id keeps one stable seller (seller_default). Listing observations expose store_id alongside product.seller."
          },
          "notes": { "type": "string" }
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "title",
          "description",
          "category",
          "currency",
          "canonical_store_id",
          "seller_default",
          "attributes",
          "reviews",
          "provenance"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "category": { "type": "string", "minLength": 1 },
          "currency": { "const": "USD" },
          "canonical_store_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Required for flat CatalogExample projection: which assortment row supplies price/stock/sponsored. Peer projector prefers this over cheapest-in-stock (avoids tarn-fell drifting to Headwater). Seller still comes from seller_default, never brand_seller."
          },
          "seller_default": {
            "type": "string",
            "minLength": 1,
            "description": "Stable brand/merchant string projected to Product.seller. Independent of host store brand_seller so co-listed SKUs keep one seller identity."
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["review_id", "rating", "text"],
              "properties": {
                "review_id": { "type": "string", "minLength": 1 },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "text": { "type": "string" }
              }
            }
          },
          "image_url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Stock photo or null. Never vendor copyrighted Amazon media in-repo."
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method"],
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "synthetic",
                  "manual_capture",
                  "partner_feed",
                  "official_api"
                ]
              },
              "retailer_hint": {
                "type": ["string", "null"],
                "description": "Optional inspiration retailer for private prototypes; not a claim of ownership."
              },
              "source_url": { "type": ["string", "null"] },
              "captured_at": { "type": ["string", "null"], "format": "date-time" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "assortment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_id",
          "store_id",
          "product_id",
          "price",
          "stock",
          "sponsored"
        ],
        "properties": {
          "listing_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[a-z0-9_-]+$",
            "description": "Stable id `{store_id}:{product_id}`."
          },
          "store_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01,
            "description": "Per-store offer; whole cents (matches Product.validate_price)."
          },
          "stock": { "type": "integer", "minimum": 0 },
          "sponsored": { "type": "boolean" }
        }
      }
    }
  }
}
